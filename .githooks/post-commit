#!/bin/sh
# Written by plotplot: the post-commit hook of a planted garden. Do not edit by hand;
# `plotplot init` rewrites this file from the beds' manifests.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# The receipt is the stem's own, and it is sealed before any bed speaks.
if [ -x "$root/.plotplot/bin/plotplot" ]; then
	"$root/.plotplot/bin/plotplot" receipt seal || exit $?
fi

# No planted bed declared post-commit.

exit 0
