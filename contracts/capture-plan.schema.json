{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotplot.ai/contracts/capture-plan.schema.json",
  "title": "capture plan",
  "description": "What one project asks mull to read: its subjects, its sources with their configuration, and, for each private stream, the consent behind it and its lifetime. Kept in the project's repository. See contracts/capture-plan.md.",
  "type": "object",
  "required": [
    "plan",
    "project",
    "portfolio",
    "subjects",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "plan": {
      "const": "1",
      "description": "the capture plan format version"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "the project's name"
    },
    "portfolio": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "the portfolio whose salt and stores the project uses"
    },
    "subjects": {
      "type": "array",
      "uniqueItems": true,
      "description": "the products and projects the project listens about, by exact identifiers",
      "items": {
        "type": "object",
        "required": [
          "name",
          "identifiers"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identifiers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "scheme",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "scheme": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "one entry per source read, in any order",
      "items": {
        "type": "object",
        "required": [
          "adapter",
          "config",
          "from",
          "private"
        ],
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "the adapter's id, as in its manifest"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "the adapter's major version the plan was written for; the runner refuses a different major version"
          },
          "config": {
            "type": "object",
            "description": "valid against the adapter manifest's config schema; an empty object for an adapter with none"
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "description": "the earliest moment of saying to read; each run continues from the last cursor"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "whom this source lets the project hear, in a sentence"
          },
          "private": {
            "type": "boolean",
            "description": "true for a private stream; its records go to the project's own store"
          },
          "consent": {
            "type": "object",
            "required": [
              "given_by",
              "given_on",
              "scope",
              "evidence"
            ],
            "additionalProperties": false,
            "description": "optional: who agreed that this private stream may be read, when, for what, and where that agreement is kept, for an owner who wants it recorded; mull requires none (the owner's ruling of 2026-10-27)",
            "properties": {
              "given_by": {
                "type": "string",
                "minLength": 1
              },
              "given_on": {
                "type": "string",
                "format": "date"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "description": "a path in the project's repository or an address where the consent is kept"
              }
            }
          },
          "lifetime_days": {
            "type": "integer",
            "minimum": 1,
            "description": "how long a private stream's records are kept before the prune command deletes them"
          },
          "terms": {
            "type": "object",
            "required": [
              "url",
              "read_on",
              "licence",
              "attribution",
              "commercial_use",
              "rate_limit",
              "restrictions",
              "deletion"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "where the terms were read"
              },
              "read_on": {
                "type": "string",
                "format": "date",
                "description": "the day they were read"
              },
              "licence": {
                "type": "string",
                "minLength": 1,
                "description": "the licence of what people post there, as the terms name it, or the words the terms use when they name none"
              },
              "attribution": {
                "type": "object",
                "required": [
                  "required"
                ],
                "additionalProperties": false,
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "how": {
                    "type": "string",
                    "minLength": 1,
                    "description": "what a reader that quotes an item must show"
                  }
                },
                "if": {
                  "properties": {
                    "required": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "required",
                    "how"
                  ]
                }
              },
              "commercial_use": {
                "enum": [
                  "allowed",
                  "forbidden",
                  "not-stated"
                ],
                "description": "whether the terms allow reading for a commercial purpose"
              },
              "rate_limit": {
                "type": "object",
                "required": [
                  "requests",
                  "per_seconds",
                  "stated_by"
                ],
                "additionalProperties": false,
                "properties": {
                  "requests": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "per_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "stated_by": {
                    "enum": [
                      "source",
                      "adapter"
                    ],
                    "description": "source when the terms or documentation state the limit; adapter when they state none and the adapter keeps its own, lower one"
                  }
                }
              },
              "restrictions": {
                "type": "array",
                "description": "each clause of the source's terms that restricts reading it by program or using what is read, quoted, with where it was read; empty when the terms restrict nothing. An entry whose source has any restriction runs only on its owner's ruling",
                "items": {
                  "type": "object",
                  "required": [
                    "says",
                    "url"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "says": {
                      "type": "string",
                      "minLength": 1,
                      "description": "the clause, quoted"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "where it was read"
                    }
                  }
                }
              },
              "deletion": {
                "type": "object",
                "required": [
                  "required"
                ],
                "additionalProperties": false,
                "description": "whether the source requires that what was read be deleted when its author deletes it, or after a time; no ruling changes this",
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "within_hours": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "how soon after the source's deletion, or after reading, it must go"
                  },
                  "how": {
                    "type": "string",
                    "minLength": 1,
                    "description": "what the source requires, in a sentence, and how mull learns of a deletion"
                  }
                },
                "if": {
                  "properties": {
                    "required": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "required",
                    "how"
                  ]
                }
              }
            },
            "description": "the site's own terms, as facts, in the shape of an adapter manifest's terms; required when the adapter's manifest sets terms_per_site"
          },
          "ruling": {
            "$ref": "#/$defs/ruling",
            "description": "the owner's ruling on this use of this source. An entry whose source's terms carry restrictions, forbid commercial use, or come from an account whose terms forbid automation runs only when its ruling allows it; an entry whose ruling refuses never runs"
          },
          "bots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "handles on this source the owner knows to be programs, as the source writes them; mull marks their records author_kind bot, from the plan"
          },
          "budget": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "the well budget this entry spends; required when the adapter is paid, which the runner checks against the manifest"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "private": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "lifetime_days"
              ]
            }
          },
          {
            "if": {
              "required": [
                "terms"
              ],
              "properties": {
                "terms": {
                  "anyOf": [
                    {
                      "properties": {
                        "restrictions": {
                          "minItems": 1
                        }
                      },
                      "required": [
                        "restrictions"
                      ]
                    },
                    {
                      "properties": {
                        "commercial_use": {
                          "const": "forbidden"
                        }
                      },
                      "required": [
                        "commercial_use"
                      ]
                    }
                  ]
                }
              }
            },
            "then": {
              "required": [
                "ruling"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "ruling": {
      "type": "object",
      "required": [
        "use",
        "by",
        "on",
        "says"
      ],
      "additionalProperties": false,
      "properties": {
        "use": {
          "enum": [
            "allowed",
            "refused"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "format": "date"
        },
        "says": {
          "type": "string",
          "minLength": 1,
          "description": "the ruling, in the owner's words or a faithful sentence"
        }
      }
    }
  }
}
