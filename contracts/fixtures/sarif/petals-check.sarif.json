{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/designs/draft.html"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "placeholder copy. Write the real words, or keep this page under a mockup path."
          },
          "ruleId": "content/placeholder"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "public/index.html"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "#3B82F6 is not in the palette. Did you mean #4E88A6?"
          },
          "properties": {
            "suggestion": "#4E88A6"
          },
          "ruleId": "color/off-palette"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "public/index.html"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "13px is outside the spacing scale. Did you mean 12px or 16px?"
          },
          "properties": {
            "suggestion": "12px or 16px"
          },
          "ruleId": "layout/spacing"
        }
