{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "\"$GEMINI_PROJECT_DIR/.plotplot/bundles/gemini/bin/plotplot\" hook gemini AfterAgent",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "\"$GEMINI_PROJECT_DIR/.plotplot/bundles/gemini/bin/plotplot\" hook gemini AfterTool",
            "timeout": 10000,
