            "type": "command"
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "command": "\"$GEMINI_PROJECT_DIR/.plotplot/bundles/gemini/bin/plotplot\" hook gemini PreCompress",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
