{
  "goal": "Settle the integration node's audit for the landed stem stack (jahala/plotplot 20): tend2 verify with audit egress on the two stamped checks, relayed by a codex auditor, no builder.",
  "source": "docs/plans/stem-reaudit.plan.json",
  "maxConcurrency": 1,
  "nodes": [
    {
      "id": "stem.audit.bundles",
      "worker": {
        "provider": "claude",
        "model": "claude-opus-5"
      },
      "work": {
        "command": "bash -lc 'cargo build --release 2>&1 | tail -1'"
      },
      "needs": [],
      "accept": {
        "smoke": "bash -lc 'cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test'",
        "audit": {
          "command": "bash -lc 'tend2 verify docs/tend2/stem.tend2.html --repo-root . --force --audit-egress --check 5 --runner \"bash {evidence} bundles\"'",
          "provider": "codex"
        }
      },
      "policy": {
        "maxAttempts": 1,
        "timeoutMs": 1800000,
        "onDead": "resume",
        "reauditWhen": [
          "compacted"
        ]
      }
    },
    {
      "id": "stem.audit.hook-faces",
      "worker": {
        "provider": "claude",
        "model": "claude-opus-5"
      },
      "work": {
        "command": "bash -lc 'cargo build --release 2>&1 | tail -1'"
      },
      "needs": [],
      "accept": {
        "smoke": "bash -lc 'cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test'",
        "audit": {
          "command": "bash -lc 'tend2 verify docs/tend2/stem.tend2.html --repo-root . --force --audit-egress --check 8 --runner \"bash {evidence} hook-faces\"'",
          "provider": "codex"
        }
      },
      "policy": {
        "maxAttempts": 1,
        "timeoutMs": 1800000,
        "onDead": "resume",
        "reauditWhen": [
          "compacted"
        ]
      }
    }
  ]
}
