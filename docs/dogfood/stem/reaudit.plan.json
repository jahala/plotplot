        "audit": {
          "command": "bash -lc 'tend2 verify docs/tend2/receipts.tend2.html --repo-root . --force --audit-egress --check 3 --runner \"bash {evidence} seal\"'",
          "provider": "opencode",
          "model": "deepseek/deepseek-v4-pro"
        }
      },
      "policy": {
        "maxAttempts": 1,
        "timeoutMs": 1800000,
        "onDead": "resume",
        "reauditWhen": [
          "compacted"
        ]
      }
    },
    {
      "id": "receipts.audit.verify",
      "worker": {
        "provider": "claude",
        "model": "claude-opus-5"
      },
      "work": {
        "command": "bash -lc 'cargo build --release 2>&1 | tail -1'"
      },
