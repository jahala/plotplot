{
  "goal": "Settle the integration node's audit for the landed stem stack (jahala/plotplot 20): tend2 verify with audit egress on the two stamped checks, relayed by an auditor on another provider, no builder.",
  "source": "docs/dogfood/stem/reaudit.plan.json",
  "maxConcurrency": 1,
  "nodes": [
    {
      "id": "stem.audit.doctor-live",
      "worker": {
        "provider": "claude",
        "model": "claude-opus-5"
      },
      "work": {
        "command": "bash -lc 'cargo build --release 2>&1 | tail -1'"
      },
      "setup": "npm ci",
      "needs": [],
      "accept": {
        "smoke": "bash -lc 'cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test'",
        "audit": {
          "command": "bash -lc 'tend2 verify docs/tend2/stem.tend2.html --repo-root . --force --audit-egress --check 9 --runner \"bash {evidence} doctor-live\"'",
          "provider": "opencode",
          "model": "deepseek/deepseek-v4-pro"
        }
      },
      "policy": {
        "maxAttempts": 1,
        "timeoutMs": 1800000,
        "onDead": "resume",
        "reauditWhen": [
          "compacted"
        ]
      }
    },
    {
      "id": "receipts.audit.seal",
      "worker": {
        "provider": "claude",
        "model": "claude-opus-5"
      },
      "work": {
