# .petalsrc — drop this at the root of the weeder repo (rename to `.petalsrc`)
brand:
  # plotplot is the umbrella brand and the brand repo.
  source: https://github.com/jahala/plotplot-ai.git
  version: v2.0.0
  # weeder's product layer is canonical in the weeder repo at .brand/products/weeder/;
  # the umbrella holds a staging copy. Commit the layer here; ignore the rest of .brand/.
  product: weeder
  overrides: {}
