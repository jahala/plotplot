# .petalsrc — drop this at the root of the weed repo (rename to `.petalsrc`)
brand:
  # plotplot is the umbrella brand and the brand repo.
  source: https://github.com/jahala/plotplot-ai.git
  version: v2.0.0
  # weed's product layer is canonical in the weed repo at .brand/products/weed/;
  # the umbrella holds a staging copy. Commit the layer here; ignore the rest of .brand/.
  product: weed
  overrides: {}
